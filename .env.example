# ─── Database ────────────────────────────────────────────────────────────────

# Postgres connection string used by apps/server, apps/worker, and drizzle-kit.
# Local dev with docker-compose: postgresql://katnor:katnor@localhost:5432/katnor
DATABASE_URL=postgresql://katnor:katnor@localhost:5432/katnor

# ─── Secrets ─────────────────────────────────────────────────────────────────

# AES key used to encrypt provider API keys and other secrets at rest in Postgres.
# Generate with: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=

# Signing secret for user session cookies/tokens.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Email + scrypt password hash for the very first user account (Phase 5's multi-user
# auth has no self-serve signup - every account after this one is created by an
# already-logged-in user through Settings > Team members). Read once, directly, by
# `pnpm db:seed` (packages/db/src/seed.ts) to create that first `user` row if none
# exists yet - NOT read by the running apps/server process itself. OWNER_PASSWORD_HASH
# must be "<saltHex>:<hashHex>", the exact format @katnor/db's src/crypto.ts's
# hashPassword/verifyPassword read and write (dependency-free, no bcrypt). Generate with:
# node -e "const c=require('node:crypto');const s=c.randomBytes(16);console.log(s.toString('hex')+':'+c.scryptSync(process.argv[1],s,64).toString('hex'))" -- 'your-password'
OWNER_EMAIL=
OWNER_PASSWORD_HASH=

# ─── LLM providers ───────────────────────────────────────────────────────────

# Anthropic API key used by the worker to run agents on Claude models. Required.
# Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI API key forwarded to the `codex` work tool's `codex exec` calls inside a
# project's sandbox (@katnor/agents' src/workTools.ts) - separate from both
# ANTHROPIC_API_KEY above and the "openai_compatible" LLM provider key in Settings,
# since this one authenticates the Codex CLI itself, not a hired agent's own model
# calls. Optional - only needed if an agent's tool_allowlist includes "codex".
OPENAI_API_KEY=

# ─── Company ─────────────────────────────────────────────────────────────────

# Display name for the company shown throughout the dashboard and office.
COMPANY_NAME=Katnor

# ─── Ports & URLs ────────────────────────────────────────────────────────────

# Port the apps/server Hono API (and WebSocket endpoint) listens on.
SERVER_PORT=3001

# Port the apps/web SvelteKit dashboard listens on.
WEB_PORT=3000

# Base URL the web dashboard uses to reach the server's tRPC/WebSocket endpoints.
PUBLIC_SERVER_URL=http://localhost:3001

# ─── Object storage (MinIO) ──────────────────────────────────────────────────

# Root/admin username for the MinIO artifact object store.
MINIO_ROOT_USER=katnor

# Root/admin password for the MinIO artifact object store.
# Generate with: openssl rand -hex 24
MINIO_ROOT_PASSWORD=

# Endpoint the server/worker use to reach MinIO's S3-compatible API.
MINIO_ENDPOINT=http://localhost:9000

# Bucket name artifacts are stored under (created on first boot if missing).
MINIO_BUCKET=katnor-artifacts

# Region MinIO's S3-compatible API reports - MinIO ignores the actual value,
# but the AWS SDK requires one be set. Optional - defaults to "us-east-1".
MINIO_REGION=us-east-1

# ─── Artifacts (PLAN.md 4.6) ──────────────────────────────────────────────────

# Where @katnor/artifacts stores artifact content: "local" (a plain directory -
# see ARTIFACT_STORAGE_DIR below) or "s3" (MinIO, via the vars above). Optional -
# defaults to "local"; docker-compose.yml overrides this to "s3" for the
# server/worker services since MinIO is already running there.
ARTIFACT_STORAGE=local

# Directory artifact content is written under when ARTIFACT_STORAGE=local.
# Optional - defaults to /tmp/katnor-artifacts.
ARTIFACT_STORAGE_DIR=/tmp/katnor-artifacts

# ─── Workspaces & work tools (PLAN.md 4.3) ────────────────────────────────────

# How the `shell`/`claude_code` work tools get an isolated place to run:
# "docker" (default) starts one container per project via the Docker socket
# (see docker-compose.yml's worker service); "host" instead uses a plain local
# directory (WORKSPACE_HOST_DIR) with no isolation - dev-only, for running
# apps/worker without Docker available at all.
SANDBOX_MODE=docker

# Image tag DockerWorkspaceManager starts project containers from - build it
# with: docker build -t katnor-sandbox:latest -f sandbox/Dockerfile .
# Optional - defaults to katnor-sandbox:latest.
SANDBOX_IMAGE=katnor-sandbox:latest

# Base directory HostWorkspaceManager creates per-project subdirectories under,
# when SANDBOX_MODE=host. Optional - defaults to /tmp/katnor-workspaces.
WORKSPACE_HOST_DIR=/tmp/katnor-workspaces

# MCP server credentials (e.g. a GitHub personal access token for the "GitHub
# MCP" server) are NOT set here as env vars - they're stored encrypted in the
# `secret` table via the dashboard's Settings > Secrets section, then
# referenced by name from a Settings > MCP servers entry's "env secret names"
# field (see @katnor/agents' src/mcpTools.ts). This keeps every secret in one
# place (the same encrypted store as provider API keys) instead of split
# between here and the database.

# ─── Knowledge: wiki & graph (PLAN.md 4.4/4.5) ────────────────────────────────

# Directory each project's git-backed wiki repo lives under (one subdirectory
# per project id) - see @katnor/knowledge's wikiStorage.ts. Read/written
# directly by both apps/server (the dashboard's wiki browser/editor) and
# apps/worker (the Librarian) - docker-compose.yml points both at the same
# shared `wiki-data` volume. Optional - defaults to /tmp/katnor-wiki.
WIKI_STORAGE_DIR=/tmp/katnor-wiki

# API key for OpenAI's text-embedding-3-small, used for vector search over
# the knowledge graph and wiki (search_knowledge/ask_wiki - see
# @katnor/knowledge's embeddings.ts for why this specific model: its native
# output size matches the 1536-dimension pgvector columns Phase 0 already
# fixed). Optional - when unset, search falls back to plain keyword
# matching instead of failing. This is deliberately separate from the
# "openai_compatible" provider key in Settings, which may point at a
# non-OpenAI, non-embeddings endpoint.
EMBEDDINGS_API_KEY=

# ─── Worker ──────────────────────────────────────────────────────────────────

# How often (ms) apps/worker logs its boot-time "worker alive" heartbeat.
# Optional - defaults to 30000 (see apps/worker/src/env.ts).
WORKER_HEARTBEAT_MS=30000
