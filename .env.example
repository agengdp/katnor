# ─── Database ────────────────────────────────────────────────────────────────

# Postgres connection string used by apps/server, apps/worker, and drizzle-kit.
# Local dev with docker-compose: postgresql://katnor:katnor@localhost:5432/katnor
DATABASE_URL=postgresql://katnor:katnor@localhost:5432/katnor

# ─── Secrets ─────────────────────────────────────────────────────────────────

# AES key used to encrypt provider API keys and other secrets at rest in Postgres.
# Generate with: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=

# Signing secret for owner session cookies/tokens.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# scrypt hash of the single owner account's password (v1 has one owner, no signup flow) -
# "<saltHex>:<hashHex>", the exact format apps/server/src/crypto.ts's hashPassword/verifyPassword
# read and write (dependency-free, no bcrypt). Generate with:
# node -e "const c=require('node:crypto');const s=c.randomBytes(16);console.log(s.toString('hex')+':'+c.scryptSync(process.argv[1],s,64).toString('hex'))" -- 'your-password'
OWNER_PASSWORD_HASH=

# ─── LLM providers ───────────────────────────────────────────────────────────

# Anthropic API key used by the worker to run agents on Claude models. Required.
# Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ─── Company ─────────────────────────────────────────────────────────────────

# Display name for the company shown throughout the dashboard and office.
COMPANY_NAME=Katnor

# ─── Ports & URLs ────────────────────────────────────────────────────────────

# Port the apps/server Hono API (and WebSocket endpoint) listens on.
SERVER_PORT=3001

# Port the apps/web SvelteKit dashboard listens on.
WEB_PORT=3000

# Base URL the web dashboard uses to reach the server's tRPC/WebSocket endpoints.
PUBLIC_SERVER_URL=http://localhost:3001

# ─── Object storage (MinIO) ──────────────────────────────────────────────────

# Root/admin username for the MinIO artifact object store.
MINIO_ROOT_USER=katnor

# Root/admin password for the MinIO artifact object store.
# Generate with: openssl rand -hex 24
MINIO_ROOT_PASSWORD=

# Endpoint the server/worker use to reach MinIO's S3-compatible API.
MINIO_ENDPOINT=http://localhost:9000

# Bucket name artifacts are stored under (created on first boot if missing).
MINIO_BUCKET=katnor-artifacts

# ─── Worker ──────────────────────────────────────────────────────────────────

# How often (ms) apps/worker logs its boot-time "worker alive" heartbeat.
# Optional - defaults to 30000 (see apps/worker/src/env.ts).
WORKER_HEARTBEAT_MS=30000
